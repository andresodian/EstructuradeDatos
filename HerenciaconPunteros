//Shape.h
#pragma once
// Base class
class Shape {
protected:
      int width;
      int height;   
public:
      void setWidth(int w);
      void setHeight(int h);
};

//Triangulo.h
#pragma once
#include "Shape.h"
class Triangulo : public Shape {
public:
	Triangulo();
	int getArea() {
		return (width * height) / 2;
	}
	
};
//Rectangulo.h
#pragma once
#include "Shape.h"
class Rectangulo: public Shape {
public:
	Rectangulo(void);
	~Rectangulo(void);
	 int getArea() { 
         return (width * height); 
      }
};

