#include "ABMamigo.h"

ABMamigo::ABMamigo(string nomArch) {
	nomArchivo = nomArch;
	amig = new Amigo();
}

ABMamigo::~ABMamigo() {
	delete amig;
}

void ABMamigo::introducirDatos(Amigo* newReg) {
	string nom;
	int ed;
	char sx;
	cout << "Nombre: ";
	cin >> nom;
	cout << "Edad: ";
	cin >> ed;
	cout << "Sexo: ";
	cin >> sx;
	newReg->setAmigo(nom, ed, sx);
}

void ABMamigo::adicionarNuevo() {
	introducirDatos(amig);
	ofstream f(nomArchivo, ios::binary | ios::app);
	if (f.is_open()) {
		amig->guardarArchivo(f);
		f.close();
	}
}

void ABMamigo::listar() {
	ifstream f(nomArchivo, ios::binary);
	if (f.is_open()) {
		while (amig->leerArchivo(f)) {
			if (amig->getEstado() == 'A') {
				cout << amig->getNombre() << "\t" << amig->getEdad() << "\t" << amig->getSexo() << endl;
			}
		}
		f.close();
	}
}
