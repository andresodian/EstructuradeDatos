using namespace std;

class Amigo {
private:
	string nombre;
	int edad;
	char sexo;
	char estado;

public:
	Amigo();
	Amigo(string nom, int ed, char sx);
	void setAmigo(string nom, int ed, char sx);
	string getNombre();
	int getEdad();
	char getSexo();
	char getEstado();
	void setEstado(char est);
	void guardarArchivo(ofstream& fsalida);
	bool leerArchivo(ifstream& fentrada);
	int getTamBytesRegistro();
};
//Amigo.cpp
#include "Amigo.h"

Amigo::Amigo() {
	nombre = "";
	edad = 0;
	sexo = ' ';
	estado = ' ';
}

Amigo::Amigo(string nom, int ed, char sx) {
	nombre = nom;
	edad = ed;
	sexo = sx;
	estado = 'A';
}

void Amigo::setAmigo(string nom, int ed, char sx) {
	nombre = nom;
	edad = ed;
	sexo = sx;
	estado = 'A';
}

string Amigo::getNombre() {
	return nombre;
}

int Amigo::getEdad() {
	return edad;
}

char Amigo::getSexo() {
	return sexo;
}

char Amigo::getEstado() {
	return estado;
}

void Amigo::setEstado(char est) {
	estado = est;
}

void Amigo::guardarArchivo(ofstream& fsalida) {
	int tam = nombre.size();
	fsalida.write(reinterpret_cast<char*>(&tam), sizeof(int));
	fsalida.write(nombre.data(), tam);
	fsalida.write(reinterpret_cast<char*>(&edad), sizeof(int));
	fsalida.write(reinterpret_cast<char*>(&sexo), sizeof(char));
	fsalida.write(reinterpret_cast<char*>(&estado), sizeof(char));
}

bool Amigo::leerArchivo(ifstream& fentrada) {
	int tam;
	if (fentrada.read(reinterpret_cast<char*>(&tam), sizeof(int))) {
		nombre.resize(tam);
		fentrada.read(&nombre[0], tam);
		fentrada.read(reinterpret_cast<char*>(&edad), sizeof(int));
		fentrada.read(reinterpret_cast<char*>(&sexo), sizeof(char));
		fentrada.read(reinterpret_cast<char*>(&estado), sizeof(char));
		return true;
	}
	return false;
}

int Amigo::getTamBytesRegistro() {
	return sizeof(int) + nombre.size() + sizeof(int) + 2;
}
